{
	"name": "dsh-manual-retry",
	"version": "0.1.0",
	"description": "Manual /retry command and non-retryable error patterns for DeepSeek Harness (port of the Pi manual-retry behavior)",
	"type": "module",
	"main": "index.js",
	"exports": {
		".": "./index.js",
		"./core.js": "./core.js",
		"./cordis.patch.yml": "./cordis.patch.yml",
		"./package.json": "./package.json"
	},
	"files": [
		"index.js",
		"core.js",
		"cordis.patch.yml",
		"README.md",
		"BEHAVIOR.md",
		"LICENSE"
	],
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		}
	},
	"scripts": {
		"test": "node --test test/*.test.mjs"
	},
	"keywords": [
		"deepseek",
		"deepseek-harness",
		"dsh",
		"cordis",
		"retry"
	],
	"author": "Xiangzhe",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/xz-dev/dsh-manual-retry.git"
	},
	"engines": {
		"node": ">=20"
	},
	"dependencies": {
		"@deepseek-ai/schemastery": "3.18.4",
		"zod": "4.6.5"
	},
	"peerDependencies": {
		"@deepseek-ai/cordis": "4.0.4",
		"@deepseek-ai/dsh-agent": "0.1.7-rc.2",
		"@deepseek-ai/dsh-commands": "0.1.7-rc.2",
		"@deepseek-ai/dsh-session-projection": "0.1.7-rc.2"
	},
	"peerDependenciesMeta": {
		"@deepseek-ai/dsh-agent": {
			"optional": true
		},
		"@deepseek-ai/dsh-commands": {
			"optional": true
		},
		"@deepseek-ai/dsh-session-projection": {
			"optional": true
		}
	}
}
